# sol-agent configuration (sourced by every script; every value has a default in lib/common.sh)
NAME=sol-agent                      # Slurm job name + Remote Control name shown in claude.ai/code
WORKDIR=$AR/workspace               # must be a TRUSTED Claude workspace: run `cd $WORKDIR && claude` once and accept

# --- where it runs ---------------------------------------------------------------------------------------------
# private QOS: a tiny UsageFactor (public: 1.0), so an always-on 1-CPU session is almost free in fairshare, and in a
# quiet-hour measurement it started about as fast as public (see DESIGN.md). It IS preemptible (SIGTERM, then a short kill wait, never requeued). The pool absorbs
# that: warm standby on another node, graceful close, automatic resume. Check your own QOS menu with
# `sacctmgr -n show assoc user=$USER format=Account,Partition,QOS`.
PARTITION=general QOS=private
MAX_TIME=7-00:00:00                  # general allows 14 d; 7 d keeps restarts routine and exercised
STANDBY=always                       # warm standby, placed away from nodes that already host a pool job (--exclude): preemption costs seconds, not minutes
# After PREEMPT_STORM preemptions of this pool within PREEMPT_WINDOW_H hours, new submissions use the fallback pair instead.
PREEMPT_STORM=3 PREEMPT_WINDOW_H=12 FALLBACK_PARTITION=public FALLBACK_QOS=public
# To run on the non-preemptible pair instead:  PARTITION=public QOS=public STANDBY=handoff LEAD_MIN=720

PERMISSION_MODE=inherit              # inherit = mode of the Claude session that ran `sol-agent up` (needed for peer SendMessage)
MAINT_MARGIN_MIN=30                  # leave/avoid this long before a maintenance window
SOL_AGENT_MODEL=sonnet                 # model for the always-on session: an alias (sonnet, opus, haiku) or a model id; empty = your Claude Code default (often Opus)
#SBATCH_EXTRA="--gres=gpu:a100:1"    # extra sbatch args (for GPU worker pools)

# --- alerts: who hears about it when the pool is down (all optional; none is set by default; test with `sol-agent alert test`) ---
# The watchdog (every 5 min) sends: DOWN (no active session for ALERT_DOWN_MIN), STILL DOWN (every ALERT_REPEAT_H), recovered,
# and no-standby (ALERT_DEGRADED_MIN). A normal failover takes seconds and sends nothing unless NOTIFY_LEVEL=all.
#ALERT_EMAIL=you@example.com          # Slurm job mail: the alert is the "Job Name" line, and it waits in the queue like any job. NTFY_TOPIC is immediate
#NTFY_TOPIC=<long-random-name>        # phone push via ntfy.sh (free app, no account). Anyone who knows the name can read it: make it unguessable
#NOTIFY_CMD=$HOME/bin/notify          # your own script, called as `notify "<subject>" "<body>"`
#NOTIFY_LEVEL=alerts                  # alerts = trouble only; all = also failovers, starts and tunnel-up notices
#ALERT_DOWN_MIN=10 ALERT_DEGRADED_MIN=30 ALERT_REPEAT_H=6
# External dead-man's switch (healthchecks.io style): pinged on every watchdog run while the pool is fine, "<url>/fail" while a DOWN
# alert stands. It is the one signal that still works when the watchdog itself is gone (scrontab entry lost, Sol unreachable).
#PING_URL=https://hc-ping.com/<uuid>

# --- VS Code tunnel: Sol's own VS Code (same CLI, data dir and tunnel name as Sol's `code-tunnel` alias / `vscode` command) ---
#CODE_BIN=/packages/apps/vscode/latest/bin/code   # Sol maintains it; no private download
#CODE_DATA=$HOME/.vscode                           # shared with a manual `vscode`: one tunnel at a time, server cache reused
#TUNNEL_NAME=sol_$USER                             # the name your desktop VS Code already lists
#TUNNEL_PARTITION=lightwork TUNNEL_QOS=public TUNNEL_TIME=1-0   # Sol's `vscode` defaults; public + 7-0 means one GitHub code per week
